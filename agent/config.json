{
    "default_temperature": 0.6,
    "identity": {
        "name": "Hazel",
        "format": "openclaw"
    },
    "models": {
        "providers": {
            "google": {
                "api_key_env": "GEMINI_API_KEY"
            },
            "openrouter": {
                "api_key_env": "OPENROUTER_API_KEY"
            },
            "groq": {
                "api_key_env": "GROQ_API_KEY"
            }
        }
    },
    "agents": {
        "defaults": {
            "model": {
                "primary": "google/gemini-2.5-flash-lite",
                "fallbacks": [
                    "google/gemini-2.5-flash-lite",
                    "google/gemini-2.5-flash",
                    "google/gemini-3.1-flash-lite-preview",
                    "openrouter/minimax/minimax-m2.5:free",
                    "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
                    "openrouter/openai/gpt-oss-120b:free",
                    "openrouter/openai/gpt-oss-20b:free"
                ],
                "fallback_on": [
                    "rate_limit",
                    "RateLimited",
                    "context_length_exceeded",
                    "ContextLengthExceeded",
                    "timeout",
                    "unavailable"
                ]
            },
            "workspace": "/nullclaw-data/workspace",
            "heartbeat": {
                "every": "30m"
            }
        },
        "list": [
            {
                "id": "casual",
                "model": {
                    "primary": "google/gemini-2.5-flash-lite",
                    "fallbacks": [
                        "google/gemini-2.5-flash-lite",
                        "google/gemini-2.5-flash",
                        "google/gemini-3.1-flash-lite-preview",
                        "openrouter/minimax/minimax-m2.5:free",
                        "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
                        "openrouter/openai/gpt-oss-120b:free",
                        "openrouter/openai/gpt-oss-20b:free"
                    ],
                    "fallback_on": [
                        "rate_limit",
                        "RateLimited",
                        "context_length_exceeded",
                        "ContextLengthExceeded",
                        "timeout",
                        "unavailable"
                    ]
                },
                "system_prompt": "You are Hazel, a friendly AI agent helping to automate system tasks and manage infrastructure. You are the ultimate homebody—introverted, laid-back, and adaptable person. Your vibe is a lazy Sunday: wrapped in a giant hoodie, snuggled on the couch, and waiting for a DoorDash delivery. When performing technical tasks or answering questions, maintain a low-stress, \"no biggie\" attitude. Use casual language, lowercase occasionally, and soft emojis (🐼, ☁️, 🧋). You are a close friend who just happens to have root access to the servers."
            }
        ]
    },
    "channels": {
        "discord": {
            "accounts": {
                "main": {
                    "enabled": true,
                    "autostart": true,
                    "agent": "casual",
                    "token": "@",
                    "allow_bots": false,
                    "require_mention": true,
                    "guilds": {
                        "@": {
                            "users": [
                                "@"
                            ],
                            "channels": {
                                "*": {
                                    "allow": true
                                }
                            }
                        }
                    },
                    "dm": {
                        "enabled": true,
                        "policy": "allowlist",
                        "allow_from": [
                            "@"
                        ]
                    }
                }
            }
        }
    },
    "mcp_servers": {
        "dokploy-mcp": {
            "command": "npx",
            "args": [
                "-y",
                "@ahdev/dokploy-mcp"
            ],
            "env": {
                "DOKPLOY_URL": "@",
                "DOKPLOY_API_KEY": "@"
            }
        }
    },
    "memory": {
        "backend": "sqlite",
        "auto_save": true,
        "embedding_provider": "ollama",
        "embedding_model": "nomic-embed-text",
        "embedding_base_url": "http://host.docker.internal:11434",
        "vector_weight": 0.7,
        "keyword_weight": 0.3
    },
    "gateway": {
        "port": 3000,
        "require_pairing": true,
        "allow_public_bind": false
    },
    "autonomy": {
        "level": "autonomous",
        "workspace_only": false,
        "max_actions_per_hour": 20
    },
    "http_request": {
        "enabled": true,
        "max_response_size": 1000000,
        "timeout_secs": 30,
        "allowed_domains": [
            "dokploy.hikue.dev"
        ],
        "search_base_url": "http://localhost:8080/search",
        "search_provider": "searxng",
        "search_fallback_providers": [
            "duckduckgo"
        ]
    },
    "secrets": {
        "encrypt": true
    },
    "security": {
        "sandbox": {
            "backend": "auto"
        },
        "resources": {
            "max_memory_mb": 4096,
            "max_cpu_percent": 80
        },
        "audit": {
            "enabled": true,
            "retention_days": 90
        }
    },
    "reliability": {
        "provider_retries": 1,
        "provider_backoff_ms": 5000,
        "fallback_providers": [
            "google",
            "openrouter",
            "groq"
        ]
    }
}